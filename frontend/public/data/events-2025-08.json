.......","lat":35.103560817847615,"lon":129.03476545708128,"nx":null,"ny":null,"start":"2025-08-22","end":null,"price":null,"rating":null,"views":null,"reviews":null,"tags":{"place_name":"또따또가","confidence":0.7,"reason":"원도심 또따또가 전시"},"story_url":null,"excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"priority":3,"hero_tags":null},{"id":272,"source":"tour_api","category":"festival","subtype":null,"title":"2025 부산나이트워크42K With 디섹·토레타!","venue":null,"address":"부산광역시 해운대구 수영강변대로 85 (우동)","url":null,"image":"http://tong.visitkorea.or.kr/cms/resource/96/3496696_image2_1.png","description":null,"lat":35.1679477491,"lon":129.1273438565,"nx":99,"ny":76,"start":"2025-08-23","end":"2025-08-24","price":null,"rating":null,"views":null,"reviews":null,"tags":null,"story_url":null,"excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"priority":3,"hero_tags":null},{"id":218,"source":"busan_festival","category":"festival","subtype":null,"title":"전 세계 크리에이티브가 한 자리에! 부산국제마케팅광고제(MAD STARS)","venue":"부산국제마케팅광고제","address":"부산광역시 해운대구 달맞이길 30 (중동, 엘시티)","url":"https://www.madstars.org","image":"https://www.visitbusan.net/uploadImgs/files/cntnts/20240416114016931_ttiel","description":"아시아 최대 규모의 마케팅·광고·디지털 콘텐츠 관련 국제 행사인 2025 부산국제마케팅광고제(MAD STARS 2025)가 AI-vertising, AI 광고 마케팅 시대를 주제로, 오는 8월 부산 해운대 일원에서 개최됩니다.\n\n\n부산국제마케팅광고제는 올해로 18회를 맞는 아시아 최대 규모의 글로벌 광고제입니다. 매년 70여 개국에서 수천 편의 작품이 출품된다. 올해에는 시그니엘 부산과 해운대 일대에서 'AI-vertising, AI 광고 마케팅 시대'를 주제로 개최된다. 심사는 마케팅, 광고, 디지털, 미디어, PR 등 다양한 분야의 전문가 340여 명으로 구성된 심사위원단이 맡는다. 예선과 세 차례의 본선 심사를 통해 최종 수상작이 결정된다.\n활기찬 여름의 에너지와 푸른 바다의 아름다움이 어우러지는 부산","lat":35.1691,"lon":129.13634,"nx":99,"ny":76,"start":"2025-08-27","end":"2025-08-29","price":"무료(일부 유료)","rating":null,"views":null,"reviews":null,"tags":null,"story_url":null,"excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"priority":8,"hero_tags":["국제","아시아"]}]}