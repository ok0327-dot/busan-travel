pularity_score":48,"title":"해양에 대한 모든 것, 부산항축제","venue":"부산항축제","address":"부산 동구 이순신대로 164","url":"https://festivalbusan.com/busanport/","image":"https://www.visitbusan.net/uploadImgs/files/cntnts/20260422164844354_ttiel","description":"[🎪 체험 신청] 10월 초. 9월 초 체험 부스. | \n부산항축제는 부산 항만을 배경으로 펼쳐지는 부산 대표 항만축제로 부산 항만의 역사성과 상징성을 시민과 관광객에게 널리 알리고 있다. \n\n올해는 화려한 불꽃과 역동적인 해양 액티비티를 중심으로 부산항의 매력을 보다 생동감 있게 체험할 수 있는 프로그램들로 구성된다. 부산항대교를 배경으로 밤하늘과 바다를 수놓는 <불꽃쇼>가 펼쳐지며, 낮에는 수로 위에서 직접 즐기는 다양한 <수상레저> 프로그램이 운영되어 부산항의 활기찬 에너지를 온몸으로 느낄 수 있다. 또한, 북항 친수공원 일대에서는 항만과 해양문화를 테마로 한 다양한 체험형 프로그램이 마련되어 색다른 즐거움을 제공한다.\n\n올해 부산항축제는 수로 위에서 즐기는 짜릿한 체험과 밤을 밝히는 장관을 통해 부산","lat":35.114414,"lon":129.0464,"nx":97,"ny":74,"start":"2026-06-19","end":"2026-06-20","price":"무료(일부 유료)","booking_required":1,"booking_deadline":null,"booking_opens_at":"2026-05-20","rating":null,"views":null,"reviews":null,"naver_reviews":null,"tags":null,"first_seen":"2026-04-23T10:41:20+00:00","story_url":null,"excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"galmaet_course":null,"galmaet_gugan":null,"priority":6,"blog_priority":6,"hero_tags":null},{"id":3845,"source":"vb_schedule","category":"festival","subtype":null,"trust_tier":null,"menu":null,"gugun":null,"popularity_score":0,"title":"2026 부산항 축제","venue":null,"address":null,"url":"https://www.visitbusan.net/schedule/view.do?boardId=BBS_0000009&menuCd=DOM_000000204012000000&dataSid=5727","image":null,"description":null,"lat":null,"lon":null,"nx":null,"ny":null,"start":"2026-06-19","end":"2026-06-20","price":null,"booking_required":null,"booking_deadline":null,"booking_opens_at":null,"rating":null,"views":null,"reviews":null,"naver_reviews":null,"tags":null,"first_seen":"2026-05-14T22:45:04+00:00","story_url":"https://www.visitbusan.net/schedule/view.do?boardId=BBS_0000009&menuCd=DOM_000000204012000000&dataSid=5727","excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"galmaet_course":null