191227114742493_ttiel","description":"\n도심 속에서 젊음의 열기를 대방출하라!\n회를 더할수록 뜨거워지는 센텀맥주축제는 동서양 남녀노소 장벽 없이 모두 한마음으로 마음껏 즐길 수 있는 축제의 장이 되었다. 페이스페인팅으로 참가 분위기는 업, 생맥주 무료 시음으로 기분 또한 업.\n다양한 이벤트와 EDM파티는 참가한 모든 이들을 충분히 흥분의 도가니 속으로 빠져들게 한다. 그동안 쌓인 스트레스, 센텀맥주축제에서 시원하게 날려버리자.\n\n","lat":35.170998,"lon":129.12697,"nx":99,"ny":76,"start":"2026-05-22","end":"2026-05-31","price":"성인 20,000원(맥주 무제한 제공)\n미성년자 10,000원(보호자동반 입장가능)","booking_required":null,"booking_deadline":null,"booking_opens_at":null,"rating":null,"views":null,"reviews":null,"naver_reviews":null,"tags":null,"first_seen":"2026-04-23T10:41:20+00:00","story_url":null,"excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"priority":6,"blog_priority":6,"hero_tags":null},{"id":2165,"source":"vb_schedule","category":"festival","subtype":null,"trust_tier":"S","menu":null,"gugun":null,"title":"제11회 부산원도심활성화축제 [택슐랭]","venue":null,"address":null,"url":"https://www.visitbusan.net/schedule/view.do?boardId=BBS_0000009&menuCd=DOM_000000204012000000&dataSid=5389","image":null,"description":null,"lat":null,"lon":null,"nx":null,"ny":null,"start":"2026-05-22","end":"2026-05-24","price":null,"booking_required":null,"booking_deadline":null,"booking_opens_at":null,"rating":null,"views":null,"reviews":null,"naver_reviews":null,"tags":null,"first_seen":"2026-04-23T22:35:43+00:00","story_url":"https://www.visitbusan.net/schedule/view.do?boardId=BBS_0000009&menuCd=DOM_000000204012000000&dataSid=5389","excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"priority":0,"blog_priority":0,"hero_tags":null},{"id":2166,"source":"vb_schedule","category":"festival","subtype":null,"trust_tier":"S","menu":null,"gugun":null,"title":"2026 센텀맥주축제","venue":null,"address":null,"url":"https://www.visitbusan.net/schedule/view.do?boardId=BBS_0000009&menuCd=DOM_000000204012000000&dataSid=5487","image":null,"description":null,"lat":null,"lon":null,"nx":null,"ny":null,"start":"2026-05-22