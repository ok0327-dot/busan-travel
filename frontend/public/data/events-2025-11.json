다는 바람도 많이 불고 춥기 때문에, 출발할 때는 약간 덥다고 느낄지라도 따뜻한 외투도 ","lat":35.152725,"lon":129.11848,"nx":99,"ny":75,"start":"2025-11-15","end":null,"price":"무료 (유료좌석 구매별도)","rating":null,"views":null,"reviews":null,"tags":null,"story_url":null,"excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"priority":6,"blog_priority":6,"hero_tags":null},{"id":251,"source":"tour_api","category":"festival","subtype":null,"title":"부산일러스트레이션페어V.6","venue":null,"address":"부산광역시 해운대구 APEC로 55 (우동)","url":null,"image":"http://tong.visitkorea.or.kr/cms/resource/70/3492570_image2_1.png","description":null,"lat":35.1687450332,"lon":129.1355209016,"nx":99,"ny":76,"start":"2025-11-21","end":"2025-11-23","price":null,"rating":null,"views":null,"reviews":null,"tags":null,"story_url":null,"excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"priority":3,"blog_priority":3,"hero_tags":null},{"id":265,"source":"tour_api","category":"festival","subtype":null,"title":"크리스마스 빌리지 부산 2025","venue":null,"address":"부산광역시 해운대구 수영강변대로 120 (우동)","url":null,"image":"http://tong.visitkorea.or.kr/cms/resource/78/3569778_image2_1.jpg","description":null,"lat":35.1710029572,"lon":129.1270687971,"nx":99,"ny":76,"start":"2025-11-27","end":"2025-12-25","price":null,"rating":null,"views":null,"reviews":null,"tags":null,"story_url":null,"excerpt":null,"hours":null,"holiday":null,"fee":null,"transport":null,"tip":null,"phone":null,"priority":3,"blog_priority":3,"hero_tags":null},{"id":228,"source":"tour_api","category":"festival","subtype":null,"title":"게임 체험 팝업 전시 ‘Game-Playground’","venue":null,"address":"부산광역시 수영구 광남로 96 (광안동, 광안 포디움프레스티지 1)","url":null,"image":"http://tong.visitkorea.or.kr/cms/resource/58/3579258_image2_1.jpg","description":null,"lat":35.1504883662,"lon":129.1151037338,"nx":99,"ny":75,"start":"2025-11-29","end":"2025-12-14","price":null,"rating":null,"views":null,"reviews":null,"tags":null,"story_url":null,"excerpt":null,"hours