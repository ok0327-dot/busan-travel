# Public Data Portal (data.go.kr) service keys
# 공공데이터포털 일반 인증키 — 아래 각 API 신청 후 발급된 키 입력

# data.go.kr 통합 키 — D6 실측으로 기관/건별 무관하게 동일 키 확인됨
# (gov-api-kr 경유. gov-api-kr/.env 의 DATA_GO_KR_KEY 와 같은 값)
# 미설정 시 아래 BUSAN_FESTIVAL_API_KEY 를 자동 승격 (하위 호환)
DATA_GO_KR_KEY=

# (legacy) Busan Festival Service — https://www.data.go.kr/data/15063500/openapi.do
BUSAN_FESTIVAL_API_KEY=

# (선택) gov-api-kr 체크아웃 경로. 미설정 시 ~/my_playground/gov-api-kr → /root/workspace/gov-api-kr 순 탐지
# GOV_API_KR_HOME=

# KOPIS Performance API — https://www.data.go.kr/data/15097805/openapi.do
KOPIS_API_KEY=

# Korea Tourism Organization TourAPI 4.0 — https://api.visitkorea.or.kr
TOUR_API_KEY=
