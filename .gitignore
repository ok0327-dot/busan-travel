.env
*.db
*.db-journal
*.db.bak-*
# Session handoff (local only) / 세션 인수인계 (로컬 전용)
HANDOFF.md
# config.js 는 배포 필수 (Kakao JS 키 담김). private repo + 도메인 제한으로 안전.
# gitignore 에서 제외.
__pycache__/
*.pyc
*.pyo
.venv/
venv/
/data/*
# 정적 메타데이터는 commit 대상 (자동 수집 결과물 X)
!/data/booking_calendar.json
/reports/
.DS_Store
# vendored gov-api-kr 는 readonly: 내부 캐시/출력물은 커밋 안 함
vendor/gov-api-kr/.cache/
vendor/gov-api-kr/*.db
vendor/gov-api-kr/data/
# Wrangler 로컬 캐시/임시 빌드 산출물 — 커밋 대상 아님
.wrangler/
# Google Takeout 원본 압축 해제 임시폴더 (parser 실행용, 결과는 my-favorites.json 에 반영됨)
.tmp-google-takeout/
# api-vault sister repo — collect.yml 에서 actions/checkout 으로 받음 (로컬 작업 시 동일 path 시뮬레이션)
/api-vault/
# 썸네일 수집 로그 (Step 5.2a)
/logs/
# Claude Code worktree/세션 artifact — 커밋 대상 아님
.claude/
